# Copy this file to `.env.local` and fill in your values.
# `.env.local` is gitignored — never commit real credentials.

# Gmail address used to log in to SMTP (must match the account that owns the App Password)
GMAIL_USER=youremail@gmail.com

# Gmail "App Password" (NOT your normal Gmail password).
# Create one at: Google Account -> Security -> 2-Step Verification -> App passwords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Where enquiry emails are delivered (e.g. your business inbox)
CONTACT_RECIPIENT=sales@eiraforklifts.com.pk

# Sender shown on outgoing enquiry emails (usually same as GMAIL_USER)
CONTACT_SENDER=youremail@gmail.com
